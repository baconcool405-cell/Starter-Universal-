local function clearRows(page)
    for _, child in ipairs(page:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function inspectPlayers(page, mode)
    clearRows(page)
    local y = 5

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            local targetPlayer = target
            makeButton(page, targetPlayer.Name,
                UDim2.fromOffset(5, y),
                UDim2.new(1, -10, 0, 36), function()
                    clearRows(page)

                    local heading = Instance.new("TextLabel")
                    heading.Position = UDim2.fromOffset(5, 5)
                    heading.Size = UDim2.new(1, -10, 0, 36)
                    heading.BackgroundTransparency = 1
                    heading.TextColor3 = Color3.new(1, 1, 1)
                    heading.Text = targetPlayer.Name .. " - avatar items"
                    heading.Parent = page

                    local ok, description = pcall(function()
                        return Players:GetHumanoidDescriptionFromUserId(
                            targetPlayer.UserId
                        )
                    end)

                    local items = {}
                    if ok and description then
                        for _, property in ipairs({
                            "HatAccessory", "HairAccessory",
                            "FaceAccessory", "NeckAccessory",
                            "ShoulderAccessory", "FrontAccessory",
                            "BackAccessory", "WaistAccessory"
                        }) do
                            local value = description[property]
                            if value and value ~= "" then
                                for id in string.gmatch(value, "%d+") do
                                    table.insert(items, id)
                                end
                            end
                        end
                    end

                    if #items == 0 then
                        local label = Instance.new("TextLabel")
                        label.Position = UDim2.fromOffset(5, 45)
                        label.Size = UDim2.new(1, -10, 0, 45)
                        label.BackgroundTransparency = 1
                        label.TextColor3 = Color3.new(1, 1, 1)
                        label.Text = "No visible accessories found."
                        label.Parent = page
                    else
                        for i, id in ipairs(items) do
                            makeButton(page, "Accessory ID: " .. id,
                                UDim2.fromOffset(5, 42 + (i - 1) * 40),
                                UDim2.new(1, -10, 0, 36), function()
                                    local msg = Instance.new("TextLabel")
                                    msg.Size = UDim2.new(1, -10, 0, 36)
                                    msg.Position = UDim2.fromOffset(5, 42 + #items * 40)
                                    msg.BackgroundTransparency = 1
                                    msg.TextColor3 = Color3.new(1, 1, 1)
                                    msg.TextWrapped = true
                                    msg.Text = "Item ID: " .. id ..
                                        " (inspection only; not equipped)"
                                    msg.Parent = page
                                end)
                        end
                    end
                end)
            y = y + 41
        end
    end

    page.CanvasSize = UDim2.fromOffset(0, y + 250)
end

